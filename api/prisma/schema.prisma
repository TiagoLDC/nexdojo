// This is your Prisma schema file

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Academy {
  id            String      @id @default(uuid())
  name          String
  ownerName     String
  logo          String?     @db.LongText
  email         String
  phone         String?
  cep           String?
  address       String?
  addressNumber String?
  pixKey        String?
  pixType       String?
  bankName      String?
  bankAgency    String?
  bankAccount   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  users         User[]
  students      Student[]
  instructors   Instructor[]
  staff         Staff[]
  templates     ClassTemplate[]
  classes       ClassSession[]
  attendance    AttendanceRecord[]
  loans         KimonoLoan[]
  finances      FinanceTransaction[]
  messages      ChatMessage[]
  events        CalendarEvent[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // superuser, admin, instructor, staff, student
  status    String   @default("Active") // Active, Inactive, Pending
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy   Academy? @relation(fields: [academyId], references: [id])
  academyId String?
}

model Student {
  id                 String   @id @default(uuid())
  name               String
  email              String?
  phone              String?
  birthDate          String?
  gender             String?
  bloodType          String?
  weight             String?
  height             String?
  emergencyContact   String?
  emergencyPhone     String?
  cep                String?
  address            String?
  addressNumber      String?
  
  // Guardian info (for minors)
  guardianName       String?
  guardianPhone      String?
  guardianCpf        String?
  guardianRelation   String?
  guardianEmail      String?

  belt               String   @default("WHITE")
  stripes            Int      @default(0)
  status             String   @default("Pending") // Active, Inactive, Pending
  joinDate           DateTime @default(now())
  lastGraduationDate String?
  totalClasses       Int      @default(0)
  totalHours         Int      @default(0)
  absentCount        Int      @default(0)
  hasLoanedKimono    Boolean  @default(false)
  photo              String?  @db.LongText

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  academy            Academy  @relation(fields: [academyId], references: [id])
  academyId          String

  attendance         AttendanceRecord[]
  loans              KimonoLoan[]
  finances           FinanceTransaction[]
  history            GraduationHistory[]
}

model GraduationHistory {
  id              String   @id @default(uuid())
  studentId       String
  previousBelt    String
  newBelt         String
  previousStripes Int
  newStripes      Int
  date            DateTime @default(now())
  notes           String?  @db.Text

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Instructor {
  id                 String   @id @default(uuid())
  academyId          String
  name               String
  email              String?
  phone              String?
  birthDate          String?
  gender             String?
  maritalStatus      String?
  cep                String?
  address            String?
  belt               String   @default("BLACK")
  stripes            Int      @default(0)
  status             String   @default("Active")
  joinDate           DateTime @default(now())
  lastGraduationDate String?
  specialties        String?
  medicalNotes       String?  @db.Text
  photo              String?  @db.LongText
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  academy            Academy  @relation(fields: [academyId], references: [id])
}

model Staff {
  id                 String   @id @default(uuid())
  academyId          String
  name               String
  email              String?
  phone              String?
  birthDate          String?
  gender             String?
  cep                String?
  address            String?
  status             String   @default("Active")
  joinDate           DateTime @default(now())
  position           String?
  medicalNotes       String?  @db.Text
  photo              String?  @db.LongText
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  academy            Academy  @relation(fields: [academyId], references: [id])
}

model ClassTemplate {
  id              String   @id @default(uuid())
  academyId       String
  name            String
  durationMinutes Int
  schedules       String?  @db.Text // JSON string of schedules

  academy         Academy  @relation(fields: [academyId], references: [id])
  classes         ClassSession[]
}

model ClassSession {
  id              String   @id @default(uuid())
  academyId       String
  templateId      String?
  name            String
  date            DateTime
  durationMinutes Int
  instructorId    String
  status          String   @default("In Progress") // In Progress, Finalized

  academy         Academy  @relation(fields: [academyId], references: [id])
  template        ClassTemplate? @relation(fields: [templateId], references: [id])
  attendance      AttendanceRecord[]
}

model AttendanceRecord {
  id              String   @id @default(uuid())
  academyId       String
  studentId       String
  classId         String
  date            DateTime @default(now())
  durationMinutes Int
  kimonoTaken     Boolean  @default(false)

  academy         Academy  @relation(fields: [academyId], references: [id])
  student         Student  @relation(fields: [studentId], references: [id])
  class           ClassSession @relation(fields: [classId], references: [id])
}

model KimonoLoan {
  id              String   @id @default(uuid())
  academyId       String
  studentId       String
  borrowedAt      DateTime @default(now())
  returnedAt      DateTime?
  status          String   @default("Active") // Active, Returned

  academy         Academy  @relation(fields: [academyId], references: [id])
  student         Student  @relation(fields: [studentId], references: [id])
}

model ChatMessage {
  id              String   @id @default(uuid())
  academyId       String
  senderId        String
  senderName      String
  senderRole      String
  content         String   @db.Text
  timestamp       DateTime @default(now())

  academy         Academy  @relation(fields: [academyId], references: [id])
}

model FinanceTransaction {
  id              String   @id @default(uuid())
  academyId       String
  studentId       String?
  description     String
  amount          Float
  type            String   // income, expense
  category        String
  date            DateTime @default(now())
  paymentMethod   String
  status          String   @default("pending") // paid, pending

  academy         Academy  @relation(fields: [academyId], references: [id])
  student         Student? @relation(fields: [studentId], references: [id])
}

model CalendarEvent {
  id              String   @id @default(uuid())
  academyId       String
  date            DateTime
  reason          String
  type            String   // no-class, event

  academy         Academy  @relation(fields: [academyId], references: [id])
}
